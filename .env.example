NODE_ENV=production
PORT=3012

# Wajib di production — kirim via header X-API-Key
API_KEY=

# Opsional: URL webhook untuk event masuk
WEBHOOK_URL=

# Anti-ban / human-like behaviour
AUTO_REPLY_PING=true
AUTO_UNIQUE_FOOTER=true
TYPING_DELAY_MIN_MS=1000
TYPING_DELAY_MAX_MS=2200
QUEUE_COOLDOWN_MIN_MS=2000
QUEUE_COOLDOWN_MAX_MS=4000
